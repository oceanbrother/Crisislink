# ── CrisisLink Frontend — Environment Variables ───────────────
# Copy this file to donor-app/.env and fill in your values.
# Never commit the actual .env file to version control.

# Base URL of the CrisisLink listing service backend.
# Local development: leave blank — Vite proxies /api → http://localhost:8000
# Production (Railway / Render / etc.): set to your deployed backend URL
VITE_API_URL=
