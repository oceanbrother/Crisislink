DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
BACKEND_PUBLIC_URL=https://your-railway-backend.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-vercel-frontend.vercel.app
ENABLE_AI_RECOGNIZER=true

# Persistent model settings (recommended with Railway Volume mounted at /data)
MODEL_DIR=/data/models
MODEL_WEIGHTS_PATH=/data/models/best_food101_convnext.pth
MODEL_CLASSES_PATH=/data/models/classes.json

# Optional: auto-download model files on startup when missing.
# MODEL_WEIGHTS_URL=https://example.com/path/best_food101_convnext.pth
# MODEL_CLASSES_URL=https://example.com/path/classes.json
